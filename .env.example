# ============================================================
# Aethryn Software Solutions – Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Site URL (used for sitemap and OG tags) ──────────────────
NEXT_PUBLIC_SITE_URL=https://aethryn.com

# ── Google Analytics 4 Measurement ID ────────────────────────
# Format: G-XXXXXXXXXX
# Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── WhatsApp Number ──────────────────────────────────────────
# Include country code, e.g. +2348012345678
NEXT_PUBLIC_WHATSAPP_NUMBER=+10000000000

# ── Contact form: recipient email ────────────────────────────
CONTACT_TO_EMAIL=aethrynsoftware@gmail.com

# ── Email provider: Resend (recommended) ─────────────────────
# Sign up at https://resend.com — generous free tier
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Email provider: SMTP fallback (if not using Resend) ──────
# Used only if RESEND_API_KEY is not set
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# ── Rate limiting ─────────────────────────────────────────────
# Max requests per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
